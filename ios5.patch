new file mode 100644
index 0000000..d76c1d0
--- /dev/null
+++ b/ios-legacy/Sources/rt_shim.c
@@ -0,0 +1,87 @@
+/* Compiler-runtime helpers for armv7 without hardware divide (Cortex-A8/A9: iPhone 3GS-4S, iPad 1/2/3).
+ *
+ * clang lowers 32/64-bit division and 64-bit<->float conversion to calls into the compiler runtime.  iOS 7+ gets those
+ * from libSystem; whether the iOS 5 libSystem exports them is not something this build can verify, and a missing symbol
+ * is a hard "Symbol not found" at launch.  Defining them inside the executable removes the question (with two-level
+ * namespaces the executable's own definition always wins, so on newer systems this simply shadows libSystem's copy).
+ *
+ * Only shifts, compares and subtractions are used below, so nothing here can compile into a call to itself.
+ * Build with -fno-builtin.  `make test-rt` style check: compile with -DWL4_RT_TEST on a host and compare to / and %. */
+#include <stdint.h>
+
+#ifdef WL4_RT_TEST
+#define RT(n) t##n
+#else
+#define RT(n) n
+#endif
+
+static uint32_t udivmod32(uint32_t n, uint32_t d, uint32_t *rem) {
+    if (d == 0) { if (rem) *rem = n; return 0; }
+    if (d > n) { if (rem) *rem = n; return 0; }
+    int shift = __builtin_clz(d) - __builtin_clz(n);
+    uint32_t q = 0;
+    d <<= shift;
+    for (int i = shift; i >= 0; i--) {
+        q <<= 1;
+        if (n >= d) { n -= d; q |= 1; }
+        d >>= 1;
+    }
+    if (rem) *rem = n;
+    return q;
+}
+
+static uint64_t udivmod64(uint64_t n, uint64_t d, uint64_t *rem) {
+    if (d == 0 || d > n) { if (rem) *rem = n; return 0; }
+    if ((n >> 32) == 0) {                                   /* both fit in 32 bits: fast path */
+        uint32_t r32; uint32_t q32 = udivmod32((uint32_t)n, (uint32_t)d, &r32);
+        if (rem) *rem = r32;
+        return q32;
+    }
+    uint32_t nh = (uint32_t)(n >> 32), dh = (uint32_t)(d >> 32);
+    int clzn = nh ? __builtin_clz(nh) : 32 + __builtin_clz((uint32_t)n);
+    int clzd = dh ? __builtin_clz(dh) : 32 + __builtin_clz((uint32_t)d);
+    int shift = clzd - clzn;
+    uint64_t q = 0;
+    d <<= shift;
+    for (int i = shift; i >= 0; i--) {
+        q <<= 1;
+        if (n >= d) { n -= d; q |= 1; }
+        d >>= 1;
+    }
+    if (rem) *rem = n;
+    return q;
+}
+
+uint32_t RT(__udivsi3)(uint32_t a, uint32_t b) { return udivmod32(a, b, 0); }
+uint32_t RT(__umodsi3)(uint32_t a, uint32_t b) { uint32_t r; udivmod32(a, b, &r); return r; }
+int32_t  RT(__divsi3)(int32_t a, int32_t b) {
+    uint32_t ua = a < 0 ? 0u - (uint32_t)a : (uint32_t)a, ub = b < 0 ? 0u - (uint32_t)b : (uint32_t)b;
+    uint32_t q = udivmod32(ua, ub, 0);
+    return (int32_t)(((a < 0) != (b < 0)) ? 0u - q : q);
+}
+int32_t  RT(__modsi3)(int32_t a, int32_t b) {
+    uint32_t ua = a < 0 ? 0u - (uint32_t)a : (uint32_t)a, ub = b < 0 ? 0u - (uint32_t)b : (uint32_t)b, r;
+    udivmod32(ua, ub, &r);
+    return (int32_t)(a < 0 ? 0u - r : r);
+}
+uint64_t RT(__udivdi3)(uint64_t a, uint64_t b) { return udivmod64(a, b, 0); }
+uint64_t RT(__umoddi3)(uint64_t a, uint64_t b) { uint64_t r; udivmod64(a, b, &r); return r; }
+int64_t  RT(__divdi3)(int64_t a, int64_t b) {
+    uint64_t ua = a < 0 ? 0ull - (uint64_t)a : (uint64_t)a, ub = b < 0 ? 0ull - (uint64_t)b : (uint64_t)b;
+    uint64_t q = udivmod64(ua, ub, 0);
+    return (int64_t)(((a < 0) != (b < 0)) ? 0ull - q : q);
+}
+int64_t  RT(__moddi3)(int64_t a, int64_t b) {
+    uint64_t ua = a < 0 ? 0ull - (uint64_t)a : (uint64_t)a, ub = b < 0 ? 0ull - (uint64_t)b : (uint64_t)b, r;
+    udivmod64(ua, ub, &r);
+    return (int64_t)(a < 0 ? 0ull - r : r);
+}
+
+/* 64-bit integer -> double/float: hi * 2^32 is exact, `lo` is exact, so the single add rounds once (correct rounding for
+ * double; the float variants go through double and may differ from compiler-rt in the last bit in rare double-rounding cases). */
+double RT(__floatundidf)(uint64_t a) { return (double)(uint32_t)(a >> 32) * 4294967296.0 + (double)(uint32_t)a; }
+double RT(__floatdidf)(int64_t a) {
+    return a < 0 ? -RT(__floatundidf)(0ull - (uint64_t)a) : RT(__floatundidf)((uint64_t)a);
+}
+float RT(__floatundisf)(uint64_t a) { return (float)RT(__floatundidf)(a); }
+float RT(__floatdisf)(int64_t a)    { return (float)RT(__floatdidf)(a); }
