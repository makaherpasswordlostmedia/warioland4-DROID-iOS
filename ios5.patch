@@ -1,9 +1,11 @@
-# Wario Land 4 - legacy iOS port (armv7, iOS 7.0 - 9.3.5; target device: iPad mini 1 / A5).
+# Wario Land 4 - legacy iOS port (armv7, iOS 5.0 - 9.3.5; devices: iPhone 3GS/4/4S, iPad 1/2/3, iPod touch 3/4, iPad mini 1).
+# iOS 5 notes: ARC with a deployment target < 6.0 makes clang link libarclite (the CI step creates an empty stand-in, the
+# code uses no []-subscripting), and Sources/rt_shim.c supplies the compiler-rt division helpers.
 # Built on Linux with Theos + the iPhoneOS 9.3 SDK (same toolchain as the Crash Bandicoot armv7 port).
 # Run ./prepare.sh first: it gathers the portable core + wasm2c output into gen/.  See ../.github/workflows/wl4-ios-legacy.yml.
 export THEOS_DEVICE_IP =
 ARCHS = armv7
-TARGET = iphone:clang:9.3:7.0
+TARGET = iphone:clang:9.3:5.0
 INSTALL_TARGET_PROCESSES = WL4Legacy
 
 include $(THEOS)/makefiles/common.mk
@@ -11,7 +13,7 @@ include $(THEOS)/makefiles/common.mk
 APPLICATION_NAME = WL4Legacy
 
 WL4Legacy_FILES = $(wildcard gen/core/*.c) $(wildcard gen/w2c/*.c) gen/stubs.c \
-	Sources/WL4Log.c Sources/main.m Sources/AppDelegate.m Sources/WL4Session.m \
+	Sources/WL4Log.c Sources/rt_shim.c Sources/main.m Sources/AppDelegate.m Sources/WL4Session.m \
 	Sources/MenuViewController.m Sources/GameViewController.m Sources/GameView.m Sources/PadView.m
 
 # UI files are ARC; the C core is not (ADDITIONAL_OBJCFLAGS only touches .m).
@@ -29,6 +31,6 @@ WL4Legacy_LDFLAGS = -framework UIKit -framework Foundation -framework QuartzCore
 
 WL4Legacy_CODESIGN_FLAGS = -SResources/entitlements.plist
 WL4Legacy_PLIST = Resources/Info.plist
-WL4Legacy_RESOURCE_FILES = $(wildcard Resources/LaunchImage*.png)
+WL4Legacy_RESOURCE_FILES = $(wildcard Resources/LaunchImage*.png) $(wildcard Resources/Default*.png)
 
 include $(THEOS_MAKE_PATH)/application.mk
