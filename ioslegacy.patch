diff --git a/ios-legacy/prepare.sh b/ios-legacy/prepare.sh
new file mode 100755
index 0000000..887a272
--- /dev/null
+++ b/ios-legacy/prepare.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Gathers everything Theos needs into ios-legacy/gen/ (never committed: it is derived from your ROM).
+#   ./prepare.sh [us|jp]        (run after port/build_wasm.sh)
+set -euo pipefail
+VER=${1:-us}
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/.." && pwd)
+W2C=${W2C:-$REPO/port/build/wasm2c}
+[ -f "$W2C/wl4.c" ] || { echo "missing $W2C/wl4.c - run port/build_wasm.sh first"; exit 1; }
+
+rm -rf "$HERE/gen"; mkdir -p "$HERE/gen/core/host" "$HERE/gen/core/hal" "$HERE/gen/w2c"
+# keep the ../hal/hal.h relative include of host.c working
+cp "$REPO"/port/host/*.c "$REPO"/port/host/*.h "$HERE/gen/core/host/"
+cp "$REPO"/port/hal/*.c  "$REPO"/port/hal/*.h  "$HERE/gen/core/hal/"
+# Theos only globs one level: flatten the .c files into gen/core, headers stay where the includes expect them
+for d in host hal; do for f in "$HERE"/gen/core/$d/*.c; do mv "$f" "$HERE/gen/core/${d}_$(basename "$f")"; done; done
+cp "$HERE"/gen/core/host/*.h "$HERE"/gen/core/hal/*.h "$HERE/gen/core/" 2>/dev/null || true
+# host.c does #include "../hal/hal.h": from gen/core/ that resolves to gen/hal/hal.h
+mkdir -p "$HERE/gen/hal" && cp "$HERE"/gen/core/hal/*.h "$HERE/gen/hal/"
+
+cp "$W2C"/* "$HERE/gen/w2c/"
+# wasm-rt uses _Thread_local; iOS < 8 / armv7 has no TLV support.  Only the single game thread runs wasm, so drop it.
+sed -i -E 's/\b_Thread_local\b//g; s/\b__thread\b//g' "$HERE"/gen/w2c/wasm-rt*.[ch] "$HERE/gen/w2c/wl4.c" "$HERE/gen/w2c/wl4.h" 2>/dev/null || true
+# runtime .c files that wl4.c already #includes must not be compiled twice
+for f in "$HERE"/gen/w2c/wasm-rt-*.c; do
+  [ -f "$f" ] || continue
+  b=$(basename "$f")
+  case "$b" in *-win.c) rm -f "$f"; continue;; esac
+  if grep -qF "\"$b\"" "$HERE/gen/w2c/wl4.c" "$HERE/gen/w2c/wl4.h"; then echo "skip $b (included by wl4.c)"; rm -f "$f"; fi
+done
+python3 "$REPO/port/tools/gen_stubs.py" "$HERE/gen/w2c/wl4.h" "$HERE/gen/stubs.c"
+
+case "$VER" in us) CODE=AWAE;; jp) CODE=AWAJ;; *) echo "VER must be us|jp"; exit 1;; esac
+printf '#define WL4_EXPECT_CODE "%s"\n' "$CODE" > "$HERE/gen/wl4_config.h"
+echo "prepared gen/ for $VER"; ls "$HERE/gen/core" "$HERE/gen/w2c" | head -40
